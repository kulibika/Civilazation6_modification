include("ToolTipLoader_Expansion2");

local BASE_AddUnitStrategicResourceTooltip_RO = AddUnitStrategicResourceTooltip;
local BASE_AddBuildingExtraCostTooltip_RO = AddBuildingExtraCostTooltip;

function GetGlobalStockUI(resIndex)
    local total = 0;
    for i = 0, 61 do
        local pPlayer = Players[i];
        if pPlayer ~= nil and pPlayer:IsAlive() then
            local pRes = pPlayer:GetResources();
            if pRes ~= nil then
                total = total + pRes:GetResourceAmount(resIndex);
            end
        end
    end
    return total;
end

function GetQuotaCostUI(baseCost, resIndex)
    local totalStock = GetGlobalStockUI(resIndex);
    local quotaCost = math.floor((totalStock / 3.0) + 0.5);
    if quotaCost < baseCost then
        return baseCost;
    end
    return quotaCost;
end

AddUnitStrategicResourceTooltip = function(unitReference, formationType, pBuildQueue)
    if unitReference == nil then return "" end
    local resource = GameInfo.Resources[unitReference.StrategicResource];
    if resource == nil then return "" end

    local baseCost = 0;
    if GameInfo.Units_XP2 ~= nil then
        for row in GameInfo.Units_XP2() do
            if row.UnitType == unitReference.UnitType and row.ResourceCost > 0 then
                baseCost = row.ResourceCost;
                break;
            end
        end
    end
    if baseCost <= 0 then
        return BASE_AddUnitStrategicResourceTooltip_RO(unitReference, formationType, pBuildQueue);
    end

    local engineCost = baseCost;
    if pBuildQueue ~= nil then
        engineCost = pBuildQueue:GetUnitResourceCost(unitReference.Index, formationType);
    end
    if unitReference.UnitType == "UNIT_SETTLER" and engineCost <= 1 then
        local resourceIcon = "[ICON_" .. resource.ResourceType .. "]";
        return Locale.Lookup("LOC_UNIT_PRODUCTION_RESOURCE_COST", engineCost, resourceIcon, resource.Name);
    end

    local dynCost = GetQuotaCostUI(baseCost, resource.Index);
    local resourceIcon = "[ICON_" .. resource.ResourceType .. "]";
    return Locale.Lookup("LOC_UNIT_PRODUCTION_RESOURCE_COST", dynCost, resourceIcon, resource.Name);
end

AddBuildingExtraCostTooltip = function(buildingHash, tooltipLines)
    local baseStr = BASE_AddBuildingExtraCostTooltip_RO(buildingHash, tooltipLines);
    local bRef = GameInfo.Buildings[buildingHash];
    if bRef ~= nil and GameInfo.Building_ResourceCosts ~= nil then
        for row in GameInfo.Building_ResourceCosts() do
            if row.BuildingType == bRef.BuildingType and row.StartProductionCost > 0 then
                local resDef = GameInfo.Resources[row.ResourceType];
                if resDef ~= nil then
                    local dynCost = GetQuotaCostUI(row.StartProductionCost, resDef.Index);
                    local icon = "[ICON_" .. resDef.ResourceType .. "]";
                    local line = Locale.Lookup("LOC_UNIT_PRODUCTION_RESOURCE_COST", dynCost, icon, resDef.Name);
                    if baseStr ~= nil and baseStr ~= "" then
                        return baseStr .. "[NEWLINE]" .. line;
                    end
                    return line;
                end
            end
        end
    end
    return baseStr;
end
