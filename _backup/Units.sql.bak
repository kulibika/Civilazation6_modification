UPDATE Units SET StrategicResource = 'RESOURCE_FOOD' WHERE UnitType IN ('UNIT_SETTLER', 'UNIT_TRADER', 'UNIT_SCOUT', 'UNIT_ARCHAEOLOGIST');
UPDATE Units SET StrategicResource = 'RESOURCE_STONE' WHERE UnitType IN ('UNIT_SLINGER', 'UNIT_ARCHER', 'UNIT_SPEARMAN', 'UNIT_CATAPULT', 'UNIT_GALLEY', 'UNIT_QUADRIREME');
UPDATE Units SET StrategicResource = 'RESOURCE_HORSES' WHERE UnitType IN ('UNIT_HEAVY_CHARIOT', 'UNIT_HORSEMAN', 'UNIT_COURSER', 'UNIT_CAVALRY');
UPDATE Units SET StrategicResource = 'RESOURCE_IRON' WHERE UnitType IN ('UNIT_SWORDSMAN', 'UNIT_CROSSBOWMAN', 'UNIT_PIKEMAN', 'UNIT_MAN_AT_ARMS', 'UNIT_KNIGHT', 'UNIT_CUIRASSIER', 'UNIT_TREBUCHET', 'UNIT_CARAVEL');
UPDATE Units SET StrategicResource = 'RESOURCE_NITER' WHERE UnitType IN ('UNIT_PIKE_AND_SHOT', 'UNIT_MUSKETMAN', 'UNIT_BOMBARD', 'UNIT_FRIGATE', 'UNIT_LINE_INFANTRY', 'UNIT_FIELD_CANNON');
UPDATE Units SET StrategicResource = 'RESOURCE_COAL' WHERE UnitType IN ('UNIT_IRONCLAD', 'UNIT_BATTLESHIP');
UPDATE Units SET StrategicResource = 'RESOURCE_OIL' WHERE UnitType IN ('UNIT_INFANTRY', 'UNIT_MACHINE_GUN', 'UNIT_AT_CREW', 'UNIT_MODERN_AT', 'UNIT_ARTILLERY', 'UNIT_TANK', 'UNIT_SUBMARINE', 'UNIT_MODERN_ARMOR', 'UNIT_MISSILE_CRUISER');
UPDATE Units SET StrategicResource = 'RESOURCE_ALUMINUM' WHERE UnitType IN ('UNIT_FIGHTER', 'UNIT_BOMBER', 'UNIT_JET_FIGHTER', 'UNIT_JET_BOMBER');
UPDATE Units SET StrategicResource = 'RESOURCE_URANIUM' WHERE UnitType IN ('UNIT_NUCLEAR_SUBMARINE');

