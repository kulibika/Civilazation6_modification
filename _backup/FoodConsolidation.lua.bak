function ConsolidateCategory(pPlayerResources, targetResName, sourceResNames)
    local targetRes = GameInfo.Resources[targetResName];
    if targetRes == nil then return end
    
    local totalGained = 0;
    for _, resName in ipairs(sourceResNames) do
        local res = GameInfo.Resources[resName];
        if res ~= nil then
            local count = pPlayerResources:GetResourceAmount(res.Index);
            if count > 0 then
                totalGained = totalGained + count;
                pPlayerResources:ChangeResourceAmount(res.Index, -count);
            end
        end
    end
    
    if totalGained > 0 then
        pPlayerResources:ChangeResourceAmount(targetRes.Index, totalGained);
    end
end

function AddPlainFarmsFood(playerId, pPlayer, pPlayerResources)
    local farmDef = GameInfo.Improvements["IMPROVEMENT_FARM"];
    local foodDef = GameInfo.Resources["RESOURCE_FOOD"];
    if farmDef == nil or foodDef == nil then return end

    local farmCount = 0;
    local plotCount = Map.GetPlotCount();
    for i = 0, plotCount - 1 do
        local plot = Map.GetPlotByIndex(i);
        if plot ~= nil and plot:GetOwner() == playerId then
            if plot:GetImprovementType() == farmDef.Index and not plot:IsImprovementPillaged() and plot:GetResourceType() == -1 then
                farmCount = farmCount + 1;
            end
        end
    end

    if farmCount > 0 then
        local carry = pPlayer:GetProperty("MOD_FARM_FOOD_CARRY") or 0;
        local total = carry + (farmCount * 0.5);
        local whole = math.floor(total);
        pPlayer:SetProperty("MOD_FARM_FOOD_CARRY", total - whole);
        if whole > 0 then
            pPlayerResources:ChangeResourceAmount(foodDef.Index, whole);
        end
    end
end

function GrantStartingFood(pPlayer, pPlayerResources)
    if pPlayer:GetProperty("MOD_STARTING_FOOD_GIVEN") == 1 then return end
    local foodDef = GameInfo.Resources["RESOURCE_FOOD"];
    if foodDef ~= nil then
        pPlayerResources:ChangeResourceAmount(foodDef.Index, 1);
        pPlayer:SetProperty("MOD_STARTING_FOOD_GIVEN", 1);
    end
end

function OnPlayerTurn(playerId)
    local pPlayer = Players[playerId];
    if pPlayer == nil or not pPlayer:IsAlive() then return end
    local pPlayerResources = pPlayer:GetResources();
    if pPlayerResources == nil then return end

    GrantStartingFood(pPlayer, pPlayerResources);

    local foodTypes = {
        "RESOURCE_WHEAT",
        "RESOURCE_RICE",
        "RESOURCE_MAIZE",
        "RESOURCE_FISH",
        "RESOURCE_CRABS",
        "RESOURCE_CATTLE",
        "RESOURCE_SHEEP",
        "RESOURCE_DEER",
        "RESOURCE_BANANAS"
    };

    local luxuryTypes = {
        "RESOURCE_SPICES",
        "RESOURCE_IVORY",
        "RESOURCE_FURS",
        "RESOURCE_TEA",
        "RESOURCE_SILK",
        "RESOURCE_COCOA",
        "RESOURCE_TOBACCO",
        "RESOURCE_COFFEE",
        "RESOURCE_INCENSE",
        "RESOURCE_SUGAR",
        "RESOURCE_COTTON",
        "RESOURCE_CITRUS",
        "RESOURCE_WINE",
        "RESOURCE_TRUFFLES",
        "RESOURCE_DYES",
        "RESOURCE_WHALES",
        "RESOURCE_PEARLS",
        "RESOURCE_OLIVES"
    };

    local mineralTypes = {
        "RESOURCE_COPPER",
        "RESOURCE_JADE",
        "RESOURCE_MARBLE",
        "RESOURCE_GYPSUM",
        "RESOURCE_SALT"
    };

    ConsolidateCategory(pPlayerResources, "RESOURCE_FOOD", foodTypes);
    ConsolidateCategory(pPlayerResources, "RESOURCE_LUXURY_GOODS", luxuryTypes);
    ConsolidateCategory(pPlayerResources, "RESOURCE_STONE", mineralTypes);
    AddPlainFarmsFood(playerId, pPlayer, pPlayerResources);
    ProcessSupplyContracts(playerId);
end

