-- Готовность игры: до первого хода/закрытия экрана загрузки не списываем ресурсы
-- (иначе UnitAddedToMap при загрузке сохранения снова списывает цену за все юниты).
local g_GameReady = false;

-- Формула квоты: см. RO_QuotaFormula ниже (N = города цивилизаций / 2)


function ConsolidateCategory(pPlayerResources, targetResName, sourceResNames)
    local targetRes = GameInfo.Resources[targetResName];
    if targetRes == nil then return end
    
    local totalGained = 0;
    for _, resName in ipairs(sourceResNames) do
        local res = GameInfo.Resources[resName];
        if res ~= nil then
            local count = pPlayerResources:GetResourceAmount(res.Index);
            if count > 0 then
                totalGained = totalGained + count;
                pPlayerResources:ChangeResourceAmount(res.Index, -count);
            end
        end
    end
    
    if totalGained > 0 then
        pPlayerResources:ChangeResourceAmount(targetRes.Index, totalGained);
    end
end

-- Еда с клеток: обычные фермы (без ресурса) + ресурсы, дающие еду.
-- Клетка учитывается, если на ней есть неразграбленное улучшение и ресурс виден игроку.
local RESOURCE_FOOD_RATES = {   -- Провизия в ход с клетки (x3 от исходных 1 / 0.5)
    RESOURCE_HORSES  = 3,
    RESOURCE_WHEAT   = 3,
    RESOURCE_BANANAS = 3,
    RESOURCE_RICE    = 3,
    RESOURCE_FISH    = 3,
    RESOURCE_CRABS   = 3,
    RESOURCE_CATTLE  = 3,
    RESOURCE_SPICES  = 1.5,
    RESOURCE_TEA     = 1.5,
    RESOURCE_FURS    = 1.5
};
local PLAIN_FARM_FOOD = 1.5;
local PLAIN_MINE_STONE = 1.5;   -- обычная шахта (без ресурса) даёт Камень (x3)

local g_ResFoodByIndex = nil;
local function GetResFoodByIndex()
    if g_ResFoodByIndex == nil then
        g_ResFoodByIndex = {};
        for resType, rate in pairs(RESOURCE_FOOD_RATES) do
            local r = GameInfo.Resources[resType];
            if r ~= nil then g_ResFoodByIndex[r.Index] = rate; end
        end
    end
    return g_ResFoodByIndex;
end

local function IsResVisible(pPlayerResources, resIndex)
    if pPlayerResources.IsResourceVisible == nil then return true end
    local ok, vis = pcall(pPlayerResources.IsResourceVisible, pPlayerResources, resIndex);
    if not ok then return true end
    return vis;
end

function AddPlainFarmsFood(playerId, pPlayer, pPlayerResources)
    local farmDef = GameInfo.Improvements["IMPROVEMENT_FARM"];
    local mineDef = GameInfo.Improvements["IMPROVEMENT_MINE"];
    local foodDef = GameInfo.Resources["RESOURCE_FOOD"];
    local stoneDef = GameInfo.Resources["RESOURCE_STONE"];
    if foodDef == nil then return end
    local rates = GetResFoodByIndex();

    local gained = 0;
    local stoneGained = 0;
    local plotCount = Map.GetPlotCount();
    for i = 0, plotCount - 1 do
        local plot = Map.GetPlotByIndex(i);
        if plot ~= nil and plot:GetOwner() == playerId then
            local imp = plot:GetImprovementType();
            if imp ~= -1 and not plot:IsImprovementPillaged() then
                local res = plot:GetResourceType();
                if res == -1 then
                    if farmDef ~= nil and imp == farmDef.Index then
                        gained = gained + PLAIN_FARM_FOOD;
                    elseif mineDef ~= nil and imp == mineDef.Index then
                        stoneGained = stoneGained + PLAIN_MINE_STONE;
                    end
                elseif rates[res] ~= nil and IsResVisible(pPlayerResources, res) then
                    gained = gained + rates[res];
                end
            end
        end
    end

    if gained > 0 then
        local carry = pPlayer:GetProperty("MOD_FARM_FOOD_CARRY") or 0;
        local total = carry + gained;
        local whole = math.floor(total);
        pPlayer:SetProperty("MOD_FARM_FOOD_CARRY", total - whole);
        if whole > 0 then
            pPlayerResources:ChangeResourceAmount(foodDef.Index, whole);
        end
    end

    if stoneGained > 0 and stoneDef ~= nil then
        local carry = pPlayer:GetProperty("MOD_MINE_STONE_CARRY") or 0;
        local total = carry + stoneGained;
        local whole = math.floor(total);
        pPlayer:SetProperty("MOD_MINE_STONE_CARRY", total - whole);
        if whole > 0 then
            pPlayerResources:ChangeResourceAmount(stoneDef.Index, whole);
        end
    end
end

function GrantStartingFood(pPlayer, pPlayerResources)
    if pPlayer:GetProperty("MOD_STARTING_FOOD_GIVEN") == 1 then return end
    local foodDef = GameInfo.Resources["RESOURCE_FOOD"];
    if foodDef ~= nil then
        pPlayerResources:ChangeResourceAmount(foodDef.Index, 1);
        pPlayer:SetProperty("MOD_STARTING_FOOD_GIVEN", 1);
    end
end

-- Диагностика поставок: запасы ресурсов игрока в начале его хода (до начислений мода)
function LogStockpiles(playerId, pPlayerResources)
    local parts = {};
    for row in GameInfo.Resources() do
        if row.ResourceClassType == "RESOURCECLASS_STRATEGIC" then
            local ok, amount = pcall(pPlayerResources.GetResourceAmount, pPlayerResources, row.Index);
            if ok and amount ~= nil and amount ~= 0 then
                table.insert(parts, string.sub(row.ResourceType, 10) .. "=" .. tostring(amount));
            end
        end
    end
    print("[RO Stock] T" .. tostring(Game.GetCurrentGameTurn()) .. " P" .. tostring(playerId) .. ": " .. table.concat(parts, ", "));
end

function OnPlayerTurn(playerId)
    local pPlayer = Players[playerId];
    if pPlayer == nil or not pPlayer:IsAlive() then return end
    local pPlayerResources = pPlayer:GetResources();
    if pPlayerResources == nil then return end

    g_GameReady = true;
    LogStockpiles(playerId, pPlayerResources);
    GrantStartingFood(pPlayer, pPlayerResources);

    local foodTypes = {
        "RESOURCE_WHEAT",
        "RESOURCE_RICE",
        "RESOURCE_MAIZE",
        "RESOURCE_FISH",
        "RESOURCE_CRABS",
        "RESOURCE_CATTLE",
        "RESOURCE_SHEEP",
        "RESOURCE_DEER",
        "RESOURCE_BANANAS"
    };

    local luxuryTypes = {
        "RESOURCE_SPICES",
        "RESOURCE_IVORY",
        "RESOURCE_FURS",
        "RESOURCE_TEA",
        "RESOURCE_SILK",
        "RESOURCE_COCOA",
        "RESOURCE_TOBACCO",
        "RESOURCE_COFFEE",
        "RESOURCE_INCENSE",
        "RESOURCE_SUGAR",
        "RESOURCE_COTTON",
        "RESOURCE_CITRUS",
        "RESOURCE_WINE",
        "RESOURCE_TRUFFLES",
        "RESOURCE_DYES",
        "RESOURCE_WHALES",
        "RESOURCE_PEARLS",
        "RESOURCE_OLIVES"
    };

    local mineralTypes = {
        "RESOURCE_COPPER",
        "RESOURCE_JADE",
        "RESOURCE_MARBLE",
        "RESOURCE_GYPSUM",
        "RESOURCE_SALT"
    };

    ConsolidateCategory(pPlayerResources, "RESOURCE_FOOD", foodTypes);
    ConsolidateCategory(pPlayerResources, "RESOURCE_LUXURY_GOODS", luxuryTypes);
    ConsolidateCategory(pPlayerResources, "RESOURCE_STONE", mineralTypes);
    AddPlainFarmsFood(playerId, pPlayer, pPlayerResources);
    ProcessSupplyContracts(playerId);
    RefreshAllBuildLocks();
end

-- Рецепты (смеси ресурсов) лежат в базе: Data/Recipes.sql
-- RO_UnitExtraCosts / RO_BuildingExtraCosts — дополнительные ресурсы сверх основного.
local g_UnitExtras = nil;
local g_BuildingExtras = nil;

local function LoadExtras(tableName, keyField)
    local result = {};
    local iter = GameInfo[tableName];
    if iter == nil then
        print("[RO Recipes] Таблица " .. tableName .. " не найдена в базе");
        return result;
    end
    for row in iter() do
        local r = GameInfo.Resources[row.ResourceType];
        if r ~= nil and row.BaseCost ~= nil and row.BaseCost > 0 then
            local key = row[keyField];
            result[key] = result[key] or {};
            table.insert(result[key], { resIndex = r.Index, base = row.BaseCost });
        end
    end
    return result;
end

function GetUnitExtraCosts(unitType)
    if g_UnitExtras == nil then g_UnitExtras = LoadExtras("RO_UnitExtraCosts", "UnitType"); end
    return g_UnitExtras[unitType] or {};
end

function GetBuildingExtraCosts(buildingType)
    if g_BuildingExtras == nil then g_BuildingExtras = LoadExtras("RO_BuildingExtraCosts", "BuildingType"); end
    return g_BuildingExtras[buildingType] or {};
end

function GetGlobalResourceStock(resIndex)
    local total = 0;
    for i = 0, 61 do
        local pPlayer = Players[i];
        if pPlayer ~= nil and pPlayer:IsAlive() then
            local pRes = pPlayer:GetResources();
            if pRes ~= nil then
                total = total + pRes:GetResourceAmount(resIndex);
            end
        end
    end
    return total;
end

function GetEnginePaidCost(baseCost)
    if GameConfiguration ~= nil and GameConfiguration.GetGameSpeedType ~= nil then
        local speedHash = GameConfiguration.GetGameSpeedType();
        for row in GameInfo.GameSpeeds() do
            if row.Hash == speedHash and row.CostMultiplier ~= nil then
                return math.floor((baseCost * row.CostMultiplier) / 100.0);
            end
        end
    end
    return baseCost;
end

-- ===========================================================================
-- ФОРМУЛА КВОТЫ (одинаковая в игровом скрипте и в интерфейсе)
--   N      = (число городов цивилизаций на карте) / 2   (города-государства не считаются), не меньше 1
--   avg(r) = средняя базовая цена ресурса r по всем рецептам (юниты, здания, доп. ресурсы)
--   C(r)   = max(1, round( B(r) * (S_world(r) / N) / avg(r) ))
-- Из мирового запаса ресурса одновременно можно создать около N "средних" объектов.
-- Цена может быть и выше, и ниже базовой: при нехватке ресурса в мире она падает.
-- ===========================================================================
local RO_AvgBaseCache = nil;

local function RO_AddBase(acc, resType, base)
    if resType == nil or base == nil or base <= 0 then return end
    local r = GameInfo.Resources[resType];
    if r == nil then return end
    local e = acc[r.Index] or { sum = 0, n = 0 };
    e.sum = e.sum + base; e.n = e.n + 1;
    acc[r.Index] = e;
end

function RO_GetAvgBase(resIndex)
    if RO_AvgBaseCache == nil then
        local acc = {};
        if GameInfo.Units_XP2 ~= nil then
            for row in GameInfo.Units_XP2() do
                if row.ResourceCost ~= nil and row.ResourceCost > 0 then
                    local u = GameInfo.Units[row.UnitType];
                    if u ~= nil and u.StrategicResource ~= nil then RO_AddBase(acc, u.StrategicResource, row.ResourceCost); end
                end
            end
        end
        if GameInfo.Building_ResourceCosts ~= nil then
            for row in GameInfo.Building_ResourceCosts() do RO_AddBase(acc, row.ResourceType, row.StartProductionCost); end
        end
        if GameInfo.RO_UnitExtraCosts ~= nil then
            for row in GameInfo.RO_UnitExtraCosts() do RO_AddBase(acc, row.ResourceType, row.BaseCost); end
        end
        if GameInfo.RO_BuildingExtraCosts ~= nil then
            for row in GameInfo.RO_BuildingExtraCosts() do RO_AddBase(acc, row.ResourceType, row.BaseCost); end
        end
        RO_AvgBaseCache = {};
        for idx, e in pairs(acc) do RO_AvgBaseCache[idx] = e.sum / e.n; end
    end
    return RO_AvgBaseCache[resIndex];
end

function RO_GetQuotaN()
    local cities = 0;
    local ids = {};
    if PlayerManager.GetAliveMajorIDs ~= nil then
        ids = PlayerManager.GetAliveMajorIDs();
    elseif PlayerManager.GetAliveMajors ~= nil then
        for _, p in ipairs(PlayerManager.GetAliveMajors()) do table.insert(ids, p:GetID()); end
    end
    for _, id in ipairs(ids) do
        local p = Players[id];
        if p ~= nil then cities = cities + p:GetCities():GetCount(); end
    end
    local n = cities / 2;
    if n < 1 then n = 1 end
    return n;
end

function RO_QuotaFormula(base, worldStock, resIndex)
    local avg = RO_GetAvgBase(resIndex) or base;
    if avg <= 0 then avg = base end
    local c = math.floor(base * (worldStock / RO_GetQuotaN()) / avg + 0.5);
    if c < 1 then c = 1 end
    return c;
end

function GetQuotaMaterialCost(baseCost, resIndex, prePaid)
    local totalStock = GetGlobalResourceStock(resIndex) + (prePaid or 0);
    return RO_QuotaFormula(baseCost, totalStock, resIndex);
end

function OnUnitAdded(playerID, unitID)
    if not g_GameReady then return end
    local pUnit = UnitManager.GetUnit(playerID, unitID);
    if pUnit == nil then return end
    -- Каждый юнит оплачивается ровно один раз
    if pUnit.GetProperty ~= nil and pUnit:GetProperty("MOD_RO_PAID") == 1 then return end
    if pUnit.SetProperty ~= nil then pUnit:SetProperty("MOD_RO_PAID", 1); end
    ChargeUnit(playerID, pUnit);
    RefreshAllBuildLocks();
end

function ChargeUnit(playerID, pUnit)
    local pPlayer = Players[playerID];
    if pPlayer == nil or not pPlayer:IsAlive() then return end
    local pPlayerResources = pPlayer:GetResources();
    if pPlayerResources == nil then return end

    GrantStartingFood(pPlayer, pPlayerResources);

    local uInfo = GameInfo.Units[pUnit:GetType()];
    if uInfo == nil then return end
    local unitTypeStr = uInfo.UnitType;

    local basePrimary = 0;
    for row in GameInfo.Units_XP2() do
        if row.UnitType == unitTypeStr and row.ResourceCost > 0 then
            basePrimary = row.ResourceCost;
            break;
        end
    end
    local enginePaid = GetEnginePaidCost(basePrimary);

    if unitTypeStr == "UNIT_SETTLER" then
        local prevCount = pPlayer:GetProperty("MOD_SETTLER_COUNT");
        if prevCount == nil then
            prevCount = pPlayer:GetCities():GetCount();
        end
        local settlerCount = prevCount + 1;
        pPlayer:SetProperty("MOD_SETTLER_COUNT", settlerCount);
        -- 1-й и 2-й поселенцы бесплатны, с 3-го движок ничего не берёт,
        -- весь рецепт (Recipes.sql) списывает Lua, каждый ресурс по квоте
        if settlerCount > 2 then
            for _, ing in ipairs(GetUnitExtraCosts(unitTypeStr)) do
                local cost = GetQuotaMaterialCost(ing.base, ing.resIndex, 0);
                pPlayerResources:ChangeResourceAmount(ing.resIndex, -cost);
            end
        end
        return;
    end

    if uInfo.StrategicResource ~= nil then
        local primaryRes = GameInfo.Resources[uInfo.StrategicResource];
        if primaryRes ~= nil and basePrimary > 0 then
            local finalPrimary = GetQuotaMaterialCost(basePrimary, primaryRes.Index, enginePaid);
            local deltaPrimary = finalPrimary - enginePaid;
            -- доплата (если цена выше списанной движком) или возврат (если ниже)
            if deltaPrimary ~= 0 then
                pPlayerResources:ChangeResourceAmount(primaryRes.Index, -deltaPrimary);
            end
        end
    end

    -- Дополнительные ресурсы рецепта (паёк еды, смеси) — каждый по квоте
    for _, ing in ipairs(GetUnitExtraCosts(unitTypeStr)) do
        local cost = GetQuotaMaterialCost(ing.base, ing.resIndex, 0);
        pPlayerResources:ChangeResourceAmount(ing.resIndex, -cost);
    end
end

local DISTRICT_RESOURCE_COSTS = {
    ["DISTRICT_CAMPUS"] = { res = "RESOURCE_STONE", cost = 15 },
    ["DISTRICT_HOLY_SITE"] = { res = "RESOURCE_STONE", cost = 15 },
    ["DISTRICT_HARBOR"] = { res = "RESOURCE_STONE", cost = 15 },
    ["DISTRICT_AQUEDUCT"] = { res = "RESOURCE_STONE", cost = 15 },
    ["DISTRICT_DAM"] = { res = "RESOURCE_STONE", cost = 20 },
    ["DISTRICT_CANAL"] = { res = "RESOURCE_STONE", cost = 20 },
    ["DISTRICT_NEIGHBORHOOD"] = { res = "RESOURCE_STONE", cost = 15 },
    ["DISTRICT_COMMERCIAL_HUB"] = { res = "RESOURCE_STONE", cost = 15 },
    ["DISTRICT_ENCAMPMENT"] = { res = "RESOURCE_IRON", cost = 15 },
    ["DISTRICT_INDUSTRIAL_ZONE"] = { res = "RESOURCE_IRON", cost = 20 },
    ["DISTRICT_THEATER"] = { res = "RESOURCE_LUXURY_GOODS", cost = 15 },
    ["DISTRICT_ENTERTAINMENT_COMPLEX"] = { res = "RESOURCE_LUXURY_GOODS", cost = 15 },
    ["DISTRICT_WATER_ENTERTAINMENT_COMPLEX"] = { res = "RESOURCE_LUXURY_GOODS", cost = 20 },
    ["DISTRICT_DIPLOMATIC_QUARTER"] = { res = "RESOURCE_LUXURY_GOODS", cost = 15 },
    ["DISTRICT_PRESERVE"] = { res = "RESOURCE_LUXURY_GOODS", cost = 15 },
    ["DISTRICT_AERODROME"] = { res = "RESOURCE_ALUMINUM", cost = 20 }
};

function OnDistrictProgress(owner, districtID, cityID, x, y, districtType, era, civilization, percentComplete, appeal, isPillaged)
    if percentComplete < 100 or isPillaged then return end
    local plot = Map.GetPlot(x, y);
    if plot == nil or plot:GetProperty("MOD_DISTRICT_PAID") == 1 then return end
    plot:SetProperty("MOD_DISTRICT_PAID", 1);

    local pPlayer = Players[owner];
    if pPlayer == nil or not pPlayer:IsAlive() then return end
    local dInfo = GameInfo.Districts[districtType];
    if dInfo == nil then return end

    local costData = DISTRICT_RESOURCE_COSTS[dInfo.DistrictType];
    if costData == nil then
        for row in GameInfo.DistrictReplaces() do
            if row.CivUniqueDistrictType == dInfo.DistrictType then
                costData = DISTRICT_RESOURCE_COSTS[row.ReplacesDistrictType];
                break;
            end
        end
    end

    if costData ~= nil then
        local pResources = pPlayer:GetResources();
        local resDef = GameInfo.Resources[costData.res];
        if pResources ~= nil and resDef ~= nil then
            pResources:ChangeResourceAmount(resDef.Index, -costData.cost);
        end
    end
end

function OnBuildingConstructed(playerID, cityID, buildingID, plotID, isOriginal)
    if not isOriginal then return end
    local pPlayer = Players[playerID];
    if pPlayer == nil or not pPlayer:IsAlive() then return end
    local bInfo = GameInfo.Buildings[buildingID];
    if bInfo == nil then return end

    local pResources = pPlayer:GetResources();
    if pResources == nil then return end

    for row in GameInfo.Building_ResourceCosts() do
        if row.BuildingType == bInfo.BuildingType and row.StartProductionCost > 0 then
            local resDef = GameInfo.Resources[row.ResourceType];
            if resDef ~= nil then
                local finalCost = GetQuotaMaterialCost(row.StartProductionCost, resDef.Index, row.StartProductionCost);
                local delta = finalCost - row.StartProductionCost;
                -- доплата или возврат разницы с ценой движка
                if delta ~= 0 then
                    pResources:ChangeResourceAmount(resDef.Index, -delta);
                end
            end
        end
    end

    -- Дополнительные ресурсы рецепта здания (Recipes.sql) — каждый по квоте
    for _, ing in ipairs(GetBuildingExtraCosts(bInfo.BuildingType)) do
        local cost = GetQuotaMaterialCost(ing.base, ing.resIndex, 0);
        pResources:ChangeResourceAmount(ing.resIndex, -cost);
    end
end

function AddSupplyContract(playerID, params)
    if params == nil then return end
    local contracts = Game:GetProperty("MOD_SUPPLY_CONTRACTS") or {};
    table.insert(contracts, {
        fromID = params.fromID,
        toID = params.toID,
        resType = params.resType,
        amount = params.amount,
        turnsLeft = params.turns
    });
    Game:SetProperty("MOD_SUPPLY_CONTRACTS", contracts);
end

function ProcessSupplyContracts(playerID)
    local contracts = Game:GetProperty("MOD_SUPPLY_CONTRACTS");
    if contracts == nil or #contracts == 0 then return end

    local updated = {};
    for _, c in ipairs(contracts) do
        if c.fromID == playerID and c.turnsLeft > 0 then
            local pFrom = Players[c.fromID];
            local pTo = Players[c.toID];
            local resDef = GameInfo.Resources[c.resType];
            if pFrom and pTo and pFrom:IsAlive() and pTo:IsAlive() and resDef then
                local rFrom = pFrom:GetResources();
                local rTo = pTo:GetResources();
                local avail = rFrom:GetResourceAmount(resDef.Index);
                local transfer = math.min(avail, c.amount);
                if transfer > 0 then
                    rFrom:ChangeResourceAmount(resDef.Index, -transfer);
                    rTo:ChangeResourceAmount(resDef.Index, transfer);
                end
            end
            c.turnsLeft = c.turnsLeft - 1;
        end
        if c.turnsLeft > 0 then
            table.insert(updated, c);
        end
    end
    Game:SetProperty("MOD_SUPPLY_CONTRACTS", updated);
end

-- ===========================================================================
-- КВОТА: запрет постройки юнитов, на которые не хватает ресурса по формуле
-- C(r) = max(1, round(B(r) * (S_world(r) / N) / avg(r))), N = города цивилизаций / 2.
-- Цену в движке во время игры поменять нельзя, поэтому формула применяется так:
-- если на складе игрока меньше C(r), юнит блокируется (SetBuildDisabled),
-- а при появлении юнита списывается разница между C(r) и ценой движка.
-- ===========================================================================
local g_UnitQuotaList = nil;

function BuildUnitQuotaList()
    -- Для каждого юнита: список ингредиентов {resIndex, base} = основной ресурс + рецепт
    g_UnitQuotaList = {};
    local byUnit = {};
    for row in GameInfo.Units_XP2() do
        if row.ResourceCost ~= nil and row.ResourceCost > 0 then
            local u = GameInfo.Units[row.UnitType];
            if u ~= nil and u.StrategicResource ~= nil then
                local r = GameInfo.Resources[u.StrategicResource];
                if r ~= nil then
                    byUnit[row.UnitType] = { { resIndex = r.Index, base = row.ResourceCost } };
                end
            end
        end
    end
    for u in GameInfo.Units() do
        local extras = GetUnitExtraCosts(u.UnitType);
        if #extras > 0 then
            byUnit[u.UnitType] = byUnit[u.UnitType] or {};
            for _, ing in ipairs(extras) do table.insert(byUnit[u.UnitType], ing); end
        end
    end
    for unitType, ingredients in pairs(byUnit) do
        local u = GameInfo.Units[unitType];
        if u ~= nil then
            table.insert(g_UnitQuotaList, { index = u.Index, unitType = unitType, ingredients = ingredients });
        end
    end
end

function SettlerNeedsQuota(pPlayer)
    local prevCount = pPlayer:GetProperty("MOD_SETTLER_COUNT");
    if prevCount == nil then
        prevCount = pPlayer:GetCities():GetCount();
    end
    return (prevCount + 1) > 2;
end

-- Юниты, которые сейчас производятся в городах игрока (их НЕ блокируем,
-- иначе игра выкидывает уже начатое производство из очереди)
local function GetUnitsInProduction(pPlayer)
    local inProd = {};
    for _, pCity in pPlayer:GetCities():Members() do
        local pQueue = pCity:GetBuildQueue();
        if pQueue ~= nil then
            local hash = nil;
            if pQueue.GetCurrentProductionTypeHash ~= nil then
                local ok, h = pcall(pQueue.GetCurrentProductionTypeHash, pQueue);
                if ok then hash = h; end
            end
            if (hash == nil or hash == 0) and pQueue.CurrentlyBuilding ~= nil then
                local ok, t = pcall(pQueue.CurrentlyBuilding, pQueue);
                if ok and t ~= nil and GameInfo.Units[t] ~= nil then inProd[GameInfo.Units[t].Index] = true; end
            end
            if hash ~= nil and hash ~= 0 then
                local u = GameInfo.Units[hash];
                if u ~= nil then inProd[u.Index] = true; end
            end
        end
    end
    return inProd;
end

function RefreshAllBuildLocks()
    if g_UnitQuotaList == nil then BuildUnitQuotaList(); end

    local worldStock = {};
    local function QuotaCost(base, resIndex)
        if worldStock[resIndex] == nil then
            worldStock[resIndex] = GetGlobalResourceStock(resIndex);
        end
        return RO_QuotaFormula(base, worldStock[resIndex], resIndex);
    end

    for i = 0, 61 do
        local pPlayer = Players[i];
        if pPlayer ~= nil and pPlayer:IsAlive() then
            local pUnits = pPlayer:GetUnits();
            local pRes = pPlayer:GetResources();
            if pUnits ~= nil and pRes ~= nil and pUnits.SetBuildDisabled ~= nil then
                local inProd = GetUnitsInProduction(pPlayer);
                for _, e in ipairs(g_UnitQuotaList) do
                    local disabled = false;
                    local free = (e.unitType == "UNIT_SETTLER") and not SettlerNeedsQuota(pPlayer);
                    if not free then
                        -- суммируем потребность по каждому ресурсу рецепта (каждый по квоте)
                        local need = {};
                        for _, ing in ipairs(e.ingredients) do
                            need[ing.resIndex] = (need[ing.resIndex] or 0) + QuotaCost(ing.base, ing.resIndex);
                        end
                        for resIndex, amount in pairs(need) do
                            if pRes:GetResourceAmount(resIndex) < amount then disabled = true; end
                        end
                    end
                    if inProd[e.index] then disabled = false; end
                    pcall(pUnits.SetBuildDisabled, pUnits, e.index, disabled);
                end
            end
        end
    end
end

function OnGameReady()
    g_GameReady = true;
    RefreshAllBuildLocks();
end

function OnDistrictProgressAndRefresh(...)
    OnDistrictProgress(...);
    RefreshAllBuildLocks();
end

function OnBuildingConstructedAndRefresh(...)
    OnBuildingConstructed(...);
    RefreshAllBuildLocks();
end

function SafeAdd(evt, fn)
    if evt ~= nil and evt.Add ~= nil then evt.Add(fn); end
end

Events.PlayerTurnActivated.Add(OnPlayerTurn);
Events.UnitAddedToMap.Add(OnUnitAdded);
Events.DistrictBuildProgressChanged.Add(OnDistrictProgressAndRefresh);
GameEvents.BuildingConstructed.Add(OnBuildingConstructedAndRefresh);
GameEvents.AddSupplyContract.Add(AddSupplyContract);

-- ===========================================================================
-- Доставка поставок из сделок (запрос приходит из окна сделки в начале хода).
-- supplies = "from:to:res:amount:enacted:dur;..."
-- Каждая поставка выполняется не больше одного раза за ход (отметка в свойстве игры).
-- Если у дающего не хватает ресурса на полную партию — договор расторгается:
-- оба игрока получают уведомление, нарушитель теряет SUPPLY_BREACH_FAVOR очков
-- мирового влияния (Diplomatic Favor), пострадавший их получает.
-- ===========================================================================
SUPPLY_BREACH_FAVOR = 20;

-- Изменение благосклонности: точное имя метода в игровом коде не подтверждено,
-- пробуем известные варианты и пишем в лог, какой сработал.
function RO_ChangeFavor(iPlayer, delta)
    local p = Players[iPlayer];
    if p == nil then return false end
    local targets = { { obj = p, names = { "ChangeDiplomaticFavor", "ChangeFavor", "AddFavor" } } };
    if p.GetDiplomacy ~= nil then
        local ok, d = pcall(p.GetDiplomacy, p);
        if ok and d ~= nil then table.insert(targets, { obj = d, names = { "ChangeFavor", "ChangeDiplomaticFavor", "AddFavor" } }); end
    end
    for _, t in ipairs(targets) do
        for _, name in ipairs(t.names) do
            local f = t.obj[name];
            if type(f) == "function" then
                local ok, err = pcall(f, t.obj, delta);
                if ok then
                    print("[RO Supply] Благосклонность игрока " .. iPlayer .. " изменена на " .. delta .. " через " .. name);
                    return true;
                end
                print("[RO Supply] " .. name .. " не сработал: " .. tostring(err));
            end
        end
    end
    print("[RO Supply] ОШИБКА: не найден способ изменить благосклонность");
    return false;
end

local function RO_NotifySupply(iPlayer, summaryKey, messageKey, ...)
    local p = Players[iPlayer];
    if p == nil or not p:IsHuman() then return end
    local summary = Locale.Lookup(summaryKey, ...);
    local message = Locale.Lookup(messageKey, ...);
    local ok = false;
    if NotificationManager ~= nil and NotificationTypes ~= nil and NotificationTypes.USER_DEFINED_1 ~= nil then
        ok = pcall(NotificationManager.SendNotification, iPlayer, NotificationTypes.USER_DEFINED_1, message, summary);
    end
    if not ok then print("[RO Supply] " .. summary .. " | " .. message); end
end

local function RO_PlayerName(iPlayer)
    local cfg = PlayerConfigurations[iPlayer];
    if cfg ~= nil then
        local ok, name = pcall(function() return Locale.Lookup(cfg:GetCivilizationShortDescription()); end);
        if ok and name ~= nil then return name; end
    end
    return tostring(iPlayer);
end

function RO_SupplyDeliver(requestingPlayer, params)
    if params == nil or params.supplies == nil then return end
    local turn = Game.GetCurrentGameTurn();
    for entry in string.gmatch(params.supplies, "[^;]+") do
        local f = {};
        for v in string.gmatch(entry, "[^:]+") do table.insert(f, tonumber(v)); end
        local fromID, toID, res, amount, enacted, dur = f[1], f[2], f[3], f[4], f[5], f[6];
        if fromID ~= nil and toID ~= nil and res ~= nil and amount ~= nil and amount > 0
            and enacted ~= nil and dur ~= nil and turn > enacted and turn < enacted + dur then
            local key = "RO_SUP_" .. fromID .. "_" .. toID .. "_" .. res .. "_" .. enacted .. "_" .. dur;
            local brokenKey = "RO_SUPB_" .. fromID .. "_" .. toID .. "_" .. res .. "_" .. enacted .. "_" .. dur;
            if Game:GetProperty(brokenKey) == nil and Game:GetProperty(key) ~= turn then
                Game:SetProperty(key, turn);
                local pFrom, pTo = Players[fromID], Players[toID];
                if pFrom ~= nil and pTo ~= nil and pFrom:IsAlive() and pTo:IsAlive() then
                    local rFrom, rTo = pFrom:GetResources(), pTo:GetResources();
                    local avail = rFrom:GetResourceAmount(res);
                    local resDef = GameInfo.Resources[res];
                    local resName = resDef ~= nil and Locale.Lookup(resDef.Name) or tostring(res);
                    if avail >= amount then
                        rFrom:ChangeResourceAmount(res, -amount);
                        rTo:ChangeResourceAmount(res, amount);
                        print("[RO Supply] Ход " .. turn .. ": " .. fromID .. " -> " .. toID .. ", " .. resName .. ": передано " .. amount);
                    else
                        -- Нарушение: договор расторгается
                        Game:SetProperty(brokenKey, turn);
                        print("[RO Supply] Ход " .. turn .. ": договор РАСТОРГНУТ: " .. fromID .. " -> " .. toID .. ", " .. resName
                            .. ": нужно " .. amount .. ", на складе " .. avail);
                        RO_ChangeFavor(fromID, -SUPPLY_BREACH_FAVOR);
                        RO_ChangeFavor(toID, SUPPLY_BREACH_FAVOR);
                        RO_NotifySupply(fromID, "LOC_RO_SUPPLY_BREACH_SUMMARY", "LOC_RO_SUPPLY_BREACH_GIVER_MESSAGE",
                            resName, amount, avail, RO_PlayerName(toID), SUPPLY_BREACH_FAVOR);
                        RO_NotifySupply(toID, "LOC_RO_SUPPLY_BREACH_SUMMARY", "LOC_RO_SUPPLY_BREACH_RECEIVER_MESSAGE",
                            resName, amount, avail, RO_PlayerName(fromID), SUPPLY_BREACH_FAVOR);
                    end
                end
            end
        end
    end
    RefreshAllBuildLocks();
end
GameEvents.RO_SupplyDeliver.Add(RO_SupplyDeliver);

-- Диагностика (один раз при загрузке): какие методы благосклонности есть у игрока в игровом коде
function RO_DumpFavorMethods()
    local p = Players[0];
    if p == nil then return end
    local found = {};
    local function scan(obj, prefix)
        local ok, mt = pcall(getmetatable, obj);
        local idx = ok and mt ~= nil and mt.__index or nil;
        for _, src in ipairs({ obj, type(idx) == "table" and idx or {} }) do
            if type(src) == "table" then
                for k, v in pairs(src) do
                    if type(k) == "string" and string.find(string.lower(k), "favor") then
                        table.insert(found, prefix .. k);
                    end
                end
            end
        end
    end
    scan(p, "Player:");
    if p.GetDiplomacy ~= nil then
        local ok, d = pcall(p.GetDiplomacy, p);
        if ok and d ~= nil then scan(d, "Diplomacy:"); end
    end
    print("[RO Supply] Методы благосклонности: " .. (#found > 0 and table.concat(found, ", ") or "не найдены перебором"));
end
pcall(RO_DumpFavorMethods);
SafeAdd(Events.LoadScreenClose, OnGameReady);
SafeAdd(Events.DiplomacyDealEnacted, function() RefreshAllBuildLocks(); end);
