INSERT OR REPLACE INTO LocalizedText (Language, Tag, Text) VALUES
('en_US', 'LOC_MOD_RESOURCE_TRADE_NAME', 'Resource Accumulation and Trade Overhaul'),
('en_US', 'LOC_MOD_RESOURCE_TRADE_DESCRIPTION', 'All resources accumulate into national stockpiles. Tradable in diplomacy deals and required for constructing buildings.'),
('ru_RU', 'LOC_MOD_RESOURCE_TRADE_NAME', 'Переработка ресурсов и торговли'),
('ru_RU', 'LOC_MOD_RESOURCE_TRADE_DESCRIPTION', 'Все ресурсы накапливаются на складах, участвуют в торговле и требуются для возведения городских построек.'),
('en_US', 'LOC_RESOURCE_FOOD_NAME', 'Food Supplies'),
('ru_RU', 'LOC_RESOURCE_FOOD_NAME', 'Провизия (Еда)'),
('en_US', 'LOC_RESOURCE_LUXURY_GOODS_NAME', 'Consumer & Luxury Goods'),
('ru_RU', 'LOC_RESOURCE_LUXURY_GOODS_NAME', 'Товары роскоши'),
('en_US', 'LOC_DIPLO_DEAL_ALREADY_TRADED_TOOLTIP', 'You have already completed a trade with this leader this turn.'),
('ru_RU', 'LOC_DIPLO_DEAL_ALREADY_TRADED_TOOLTIP', 'Вы уже заключали сделку с этим лидером на этом ходу.');

-- ===== Религиозная присяга =====
INSERT OR REPLACE INTO LocalizedText (Language, Tag, Text) VALUES
('ru_RU', 'LOC_RO_SUBJ_ACTION_NAME', 'ПРОВЕСТИ АГИТАЦИЮ'),
('en_US', 'LOC_RO_SUBJ_ACTION_NAME', 'AGITATE'),
('ru_RU', 'LOC_RO_SUBJ_ACTION_DESCRIPTION', 'Апостол призывает жителей чужого города присягнуть вашей вере. Город переходит к вам, если ваша религия преобладает в нём {1_Turns} ходов подряд и в нём проведено {2_Num} агитаций. Тратит все очки движения. Столицы цивилизаций не переходят, города-государства — переходят.'),
('en_US', 'LOC_RO_SUBJ_ACTION_DESCRIPTION', 'The Apostle urges the citizens of a foreign city to swear allegiance to your faith. The city joins you once your religion has been its majority for {1_Turns} turns in a row and {2_Num} agitations have been held there. Uses all movement. Civilization capitals cannot be won this way; city-states can.'),
('ru_RU', 'LOC_RO_SUBJ_ACTION_CHARGES', 'Осталось агитаций у этого Апостола: {1_Left} из {2_Max}'),
('en_US', 'LOC_RO_SUBJ_ACTION_CHARGES', 'Agitations left for this Apostle: {1_Left} of {2_Max}'),
('ru_RU', 'LOC_RO_SUBJ_ACTION_PROGRESS', '{1_City}: ходов с вашей религией {2_T}/{3_TR}, агитаций {4_A}/{5_AR}'),
('en_US', 'LOC_RO_SUBJ_ACTION_PROGRESS', '{1_City}: turns with your religion {2_T}/{3_TR}, agitations {4_A}/{5_AR}'),

('ru_RU', 'LOC_RO_SUBJ_DISABLED_NO_CHARGES', 'Этот Апостол уже исчерпал лимит агитаций.'),
('en_US', 'LOC_RO_SUBJ_DISABLED_NO_CHARGES', 'This Apostle has no agitations left.'),
('ru_RU', 'LOC_RO_SUBJ_DISABLED_NO_MOVES', 'Нет очков движения.'),
('en_US', 'LOC_RO_SUBJ_DISABLED_NO_MOVES', 'No movement left.'),
('ru_RU', 'LOC_RO_SUBJ_DISABLED_NO_CITY', 'Апостол должен стоять в чужом городе или рядом с ним.'),
('en_US', 'LOC_RO_SUBJ_DISABLED_NO_CITY', 'The Apostle must be in or next to a foreign city.'),
('ru_RU', 'LOC_RO_SUBJ_DISABLED_CAPITAL', 'Столицы цивилизаций нельзя склонить к присяге.'),
('en_US', 'LOC_RO_SUBJ_DISABLED_CAPITAL', 'Civilization capitals cannot be won over.'),
('ru_RU', 'LOC_RO_SUBJ_DISABLED_NO_RELIGION', 'Нужно основать собственную религию.'),
('en_US', 'LOC_RO_SUBJ_DISABLED_NO_RELIGION', 'You must found a religion first.'),
('ru_RU', 'LOC_RO_SUBJ_DISABLED_NOT_MAJORITY', 'Ваша религия не преобладает в этом городе.'),
('en_US', 'LOC_RO_SUBJ_DISABLED_NOT_MAJORITY', 'Your religion is not the majority in this city.'),
('ru_RU', 'LOC_RO_SUBJ_DISABLED_AGIT_FULL', 'В этом городе уже проведено достаточно агитаций, осталось дождаться нужного числа ходов.'),
('en_US', 'LOC_RO_SUBJ_DISABLED_AGIT_FULL', 'Enough agitations have been held here; wait for the required turns.'),

('ru_RU', 'LOC_RO_SUBJ_AGITATION_FLOAT', 'Агитация {1_A}/{2_AR}'),
('en_US', 'LOC_RO_SUBJ_AGITATION_FLOAT', 'Agitation {1_A}/{2_AR}'),
('ru_RU', 'LOC_RO_SUBJ_AGITATED_SUMMARY', 'Агитация в городе {1_City}'),
('en_US', 'LOC_RO_SUBJ_AGITATED_SUMMARY', 'Agitation in {1_City}'),
('ru_RU', 'LOC_RO_SUBJ_AGITATED_MESSAGE', 'Чужие проповедники склоняют {1_City} к присяге: агитаций {2_A}/{3_AR}, ходов с чужой религией {4_T}/{5_TR}. Верните городу свою веру, чтобы сбросить счётчики.'),
('en_US', 'LOC_RO_SUBJ_AGITATED_MESSAGE', 'Foreign preachers are turning {1_City}: agitations {2_A}/{3_AR}, turns under a foreign religion {4_T}/{5_TR}. Restore your faith there to reset the counters.'),
('ru_RU', 'LOC_RO_SUBJ_CITY_GAINED_SUMMARY', '{1_City} присягнул вам'),
('en_US', 'LOC_RO_SUBJ_CITY_GAINED_SUMMARY', '{1_City} has joined you'),
('ru_RU', 'LOC_RO_SUBJ_CITY_GAINED_MESSAGE', 'Жители города {1_City} приняли вашу веру и перешли под вашу власть.'),
('en_US', 'LOC_RO_SUBJ_CITY_GAINED_MESSAGE', 'The people of {1_City} embraced your faith and joined your empire.'),
('ru_RU', 'LOC_RO_SUBJ_CITY_LOST_SUMMARY', '{1_City} отпал от вас'),
('en_US', 'LOC_RO_SUBJ_CITY_LOST_SUMMARY', '{1_City} has left you'),
('ru_RU', 'LOC_RO_SUBJ_CITY_LOST_MESSAGE', 'Жители города {1_City} присягнули чужой вере и перешли к её основателю.'),
('en_US', 'LOC_RO_SUBJ_CITY_LOST_MESSAGE', 'The people of {1_City} swore allegiance to a foreign faith and joined its founder.'),
('ru_RU', 'LOC_RO_SUBJ_TRANSFER_FAILED_SUMMARY', 'Присяга не удалась'),
('en_US', 'LOC_RO_SUBJ_TRANSFER_FAILED_SUMMARY', 'Allegiance failed'),
('ru_RU', 'LOC_RO_SUBJ_TRANSFER_FAILED_MESSAGE', 'Условия для {1_City} выполнены, но игра не смогла передать город. Подробности в Lua.log.'),
('en_US', 'LOC_RO_SUBJ_TRANSFER_FAILED_MESSAGE', 'Conditions for {1_City} are met, but the game could not transfer the city. See Lua.log.'),

('ru_RU', 'LOC_POLICY_RO_PREACHERS_NAME', 'Проповедники'),
('en_US', 'LOC_POLICY_RO_PREACHERS_NAME', 'Preachers'),
('ru_RU', 'LOC_POLICY_RO_PREACHERS_DESCRIPTION', 'Каждый Апостол может провести до 3 агитаций вместо 1.'),
('en_US', 'LOC_POLICY_RO_PREACHERS_DESCRIPTION', 'Each Apostle can hold up to 3 agitations instead of 1.'),
('ru_RU', 'LOC_POLICY_RO_MISSION_ORDER_NAME', 'Миссионерский орден'),
('en_US', 'LOC_POLICY_RO_MISSION_ORDER_NAME', 'Missionary Order'),
('ru_RU', 'LOC_POLICY_RO_MISSION_ORDER_DESCRIPTION', 'Каждый Апостол может провести до 5 агитаций вместо 1.'),
('en_US', 'LOC_POLICY_RO_MISSION_ORDER_DESCRIPTION', 'Each Apostle can hold up to 5 agitations instead of 1.'),
('ru_RU', 'LOC_RO_QUOTA_NOT_ENOUGH', 'Не хватает по квоте: нужно {1_Cost} {2_Icon} {3_Name}, на складе {4_Have}.'),
('en_US', 'LOC_RO_QUOTA_NOT_ENOUGH', 'Quota not met: need {1_Cost} {2_Icon} {3_Name}, you have {4_Have}.'),
('ru_RU', 'LOC_RO_SUBJ_REJECTED', 'Агитация невозможна: {1_Reason}'),
('en_US', 'LOC_RO_SUBJ_REJECTED', 'Cannot agitate: {1_Reason}'),
('ru_RU', 'LOC_RO_SUBJ_SCRIPT_NOT_LOADED', 'Игровой скрипт агитации не загружен в этой игре: кнопка ничего не сделает. Начните новую игру с включённым модом.'),
('en_US', 'LOC_RO_SUBJ_SCRIPT_NOT_LOADED', 'The agitation gameplay script is not loaded in this game, so the button does nothing. Start a new game with the mod enabled.'),
('ru_RU', 'LOC_RO_SUPPLY_MODE_OFF', 'Поставка за ход'),
('en_US', 'LOC_RO_SUPPLY_MODE_OFF', 'Supply per turn'),
('ru_RU', 'LOC_RO_SUPPLY_MODE_ON', 'Поставка за ход: ВКЛ'),
('en_US', 'LOC_RO_SUPPLY_MODE_ON', 'Supply per turn: ON'),
('ru_RU', 'LOC_RO_SUPPLY_MODE_TT', 'Включите, чтобы клик по ресурсу добавлял не разовую передачу, а поставку каждый ход. Количество в ход и число ходов меняются кликом по поставке в предложении.'),
('en_US', 'LOC_RO_SUPPLY_MODE_TT', 'When on, clicking a resource adds a per-turn supply instead of a one-time transfer. Click the supply in the offer to set the amount per turn and the number of turns.'),
('ru_RU', 'LOC_RO_SUPPLY_ITEM_TT', '{1_Name}: {2_Amount} в ход, {3_Turns} ходов'),
('en_US', 'LOC_RO_SUPPLY_ITEM_TT', '{1_Name}: {2_Amount} per turn for {3_Turns} turns'),
('ru_RU', 'LOC_RO_SUPPLY_TURNS_MORE', '+5 ходов'),
('ru_RU', 'LOC_RO_SUPPLY_TURNS_PLUS_1', '+1 ход'),
('en_US', 'LOC_RO_SUPPLY_TURNS_PLUS_1', '+1 turn'),
('ru_RU', 'LOC_RO_SUPPLY_TURNS_MINUS_1', '−1 ход'),
('en_US', 'LOC_RO_SUPPLY_TURNS_MINUS_1', '−1 turn'),
('en_US', 'LOC_RO_SUPPLY_TURNS_MORE', '+5 turns'),
('ru_RU', 'LOC_RO_SUPPLY_TURNS_LESS', '−5 ходов'),
